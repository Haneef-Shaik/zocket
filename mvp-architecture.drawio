                <mxCell id="m6-barriers_43" value="&lt;b&gt;8 · Policy templates&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDF1DE;strokeColor=#B45309;fontColor=#4A2A08;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
