                </mxCell>
                <mxCell id="m4-plan-grammar_58" value="reason (5 codes) · missing" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="220" y="756" width="260" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="m4-plan-grammar_59" value="— no window —" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="480" y="756" width="210" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="m4-plan-grammar_60" value="CompileError if it ever reaches here" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="690" y="756" width="220" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="m4-plan-grammar_61" value="no SQL, no rows — compose.refusal() writes the prose" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="910" y="756" width="330" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="m4-plan-grammar_62" value="none" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="756" width="110" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="m4-plan-grammar_63" value="&lt;b&gt;Two shapes where “the model decides” quietly stops being true&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;diagnose_drop&lt;/b&gt; always counts rows on both sides of the comparison, whether or not anyone asked. Row count is what separates “performance collapsed” from “the load was incomplete”, and the model is not trusted to remember to ask for it.&lt;br&gt;&lt;br&gt;&lt;b&gt;turn_off_candidate&lt;/b&gt; carries no fields. TURN_OFF_POLICY supplies every threshold — 28 days, objective = conversions, ≥ $5,000 spend, rank by ROAS ascending — and they are stated back to the user with the answer, because the criteria &lt;i&gt;are&lt;/i&gt; the answer." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDF1DE;strokeColor=#B45309;fontColor=#4A2A08;" parent="1" vertex="1">
                    <mxGeometry x="40" y="852" width="690" height="172" as="geometry"/>
                </mxCell>
                <mxCell id="m4-plan-grammar_64" value="Three rules hold across all eight emitters:&lt;br&gt;&lt;br&gt;1. Metric SQL comes from the catalogue. A ratio is&lt;br&gt;   SUM(a)/SUM(b) after aggregation — never AVG(a/b),&lt;br&gt;   which is a different and usually wrong number.&lt;br&gt;2. Values are bound ($tenant, $from, $f0); identifiers&lt;br&gt;   come from fixed maps. Free-form text never reaches SQL.&lt;br&gt;3. The SQL emitted is the SQL that runs AND the SQL the&lt;br&gt;   user is shown. There is no second &quot;explanation&quot; query&lt;br&gt;   that could drift from the real one." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#F3FAF9;strokeColor=#A8D3CC;fontColor=#08302C;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="750" y="852" width="670" height="172" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
