                </mxCell>
                <mxCell id="m2-request-path_29" value="&lt;b&gt;14 · response&lt;/b&gt;&lt;br&gt;the whole Answer, every time&lt;br&gt;&lt;i&gt;app/api/ask/route.ts&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
