                <mxCell id="m6-barriers_35" value="BigInt leakage, and defects touching exactly these rows" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
