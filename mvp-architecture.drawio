                <mxCell id="m6-barriers_36" value="a ROAS quoted with no note that 91 rows used a carried-forward FX rate, or that 5 rows have no campaign" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
