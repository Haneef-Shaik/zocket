                </mxCell>
                <mxCell id="m5-exits_42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#7A4FD1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="m5-exits_23" target="m5-exits_24" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m5-exits_43" value="unsupported figures" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#7A4FD1;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="m5-exits_23" target="m5-exits_25" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m5-exits_44" value="throws" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#C2410C;dashed=1;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="m5-exits_23" target="m5-exits_26" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m5-exits_45" value="&lt;b&gt;Read the five exits as one property&lt;/b&gt;&lt;br&gt;&lt;br&gt;A · the refusal is composed from the validator&#39;s verdict and never goes near a model. Q5 (“how do we compare to competitors?”) takes this path with &lt;b&gt;one&lt;/b&gt; model call, not two.&lt;br&gt;&lt;br&gt;B · “no rows matched” and “I cannot answer that” are different facts. Collapsing them is how a system starts sounding confident about nothing.&lt;br&gt;&lt;br&gt;C/D/E · losing the narrator costs style and nothing else. The figures were never the model&#39;s to produce, so the degradation is prose quality — not correctness, and not availability." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E8EBEF;strokeColor=#4A5568;fontColor=#1A202C;" parent="1" vertex="1">
                    <mxGeometry x="60" y="990" width="420" height="252" as="geometry"/>
                </mxCell>
                <mxCell id="m5-exits_46" value="One asymmetry worth noticing: a provider failure during PLANNING fails the request (there is no plan, so there is nothing to answer), while a provider failure during NARRATION does not — the try/catch around narrate() falls through to the template over the same verified rows. That is the trust boundary showing up as an availability property." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1250" width="1380" height="70" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
