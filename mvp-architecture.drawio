                </mxCell>
                <mxCell id="m5-exits_21" value="result.rows.length === 0 ?" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="560" y="840" width="340" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="m5-exits_22" value="&lt;b&gt;EXIT B · answered, empty&lt;/b&gt;&lt;br&gt;“…this is an empty result rather than a missing one — the filters excluded every row.”&lt;br&gt;deliberately &lt;i&gt;not&lt;/i&gt; the same answer as a refusal" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
