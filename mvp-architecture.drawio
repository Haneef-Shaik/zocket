                </mxCell>
                <mxCell id="m2-request-path_27" value="&lt;b&gt;13 · checkNarration()&lt;/b&gt;&lt;br&gt;every numeral, re-checked&lt;br&gt;&lt;i&gt;src/verify/narratorGuard.ts&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1676" width="360" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="m2-request-path_28" value="tokenize the prose -&gt; [162.5k, 398.3k, 5]   (dates stripped first)&lt;br&gt;supported = cell values + column totals + flag counts + row counts&lt;br&gt;          + derived percentages between any two supported values&lt;br&gt;unsupported -&gt; one correction pass naming the figures -&gt; else throw" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
