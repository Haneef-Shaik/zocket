                <mxCell id="m7-the-check_47" value="n5" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDE8E0;strokeColor=#C2410C;fontColor=#5A1D08;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1200" width="70" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_48" value="May&#39;s spend" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="150" y="1200" width="250" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_49" value="returning $0" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="400" y="1200" width="370" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_50" value="n13" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDF1DE;strokeColor=#B45309;fontColor=#4A2A08;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="770" y="1200" width="70" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_51" value="budget caps" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="840" y="1200" width="250" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_52" value="over-refusing an answerable question" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="1200" width="370" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_53" value="Change safety, concretely: a prompt edit is a production change. Layer 2 is the gate — prompt v7 scores 12/12, v8 scores 10/12, v8 is rejected. Every answer also carries semanticVersion, policyVersion, planGrammarVersion, compilerVersion and both prompt versions, so a disputed number is a diff rather than an argument." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1252" width="1380" height="50" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="m8-credentials" name="8 · Credentials, quota, isolation">
        <mxGraphModel dx="966" dy="856" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1160" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="m8-credentials_1" value="Credentials, quota, and what never crosses a boundary" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#0F172A;fontSize=22;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="1200" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_2" value="The MVP is single-tenant and unauthenticated by design — but it handles somebody else&#39;s API key, so the rules are narrow and written down rather than assumed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="40" y="60" width="1410" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_3" value="LLM call" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#EFE8FF;strokeColor=#7A4FD1;fontColor=#2B1A55;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="108" width="168" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_4" value="Deterministic code" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="218" y="108" width="168" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_5" value="Versioned definition" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDF1DE;strokeColor=#B45309;fontColor=#4A2A08;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="396" y="108" width="168" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_6" value="Stop / error exit" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDE8E0;strokeColor=#C2410C;fontColor=#5A1D08;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="574" y="108" width="168" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_7" value="Infrastructure" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E8EBEF;strokeColor=#4A5568;fontColor=#1A202C;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="752" y="108" width="168" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_8" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;localStorage key &lt;i&gt;da.azure.credentials&lt;/i&gt;&lt;br&gt;re-sent per request, so the user revokes by clearing it&lt;br&gt;read wrapped in try/catch — private mode falls back to the shared key" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E8EBEF;strokeColor=#4A5568;fontColor=#1A202C;" parent="1" vertex="1">
                    <mxGeometry x="60" y="175" width="400" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_9" value="&lt;b&gt;POST body only&lt;/b&gt;&lt;br&gt;never a query string — those land in access logs, browser history and referrer headers" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="540" y="175" width="400" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_10" value="&lt;b&gt;Server, for one request&lt;/b&gt;&lt;br&gt;never written to disk · never logged · never in the trace · never echoed back&lt;br&gt;no server-side store at all" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="175" width="420" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#4A5568;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="m8-credentials_8" target="m8-credentials_9" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="m8-credentials_9" target="m8-credentials_10" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_13" value="resolveLlmConfig(credentials)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="540" y="355" width="400" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="m8-credentials_9" target="m8-credentials_13" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_15" value="&lt;b&gt;mode: &quot;byok&quot;&lt;/b&gt; — key AND endpoint supplied&lt;br&gt;&lt;br&gt;• any deployment name is allowed — they know their resource, and they are paying&lt;br&gt;• quota is &lt;b&gt;not&lt;/b&gt; charged: UNLIMITED&lt;br&gt;• a key &lt;i&gt;without&lt;/i&gt; an endpoint is a 400, not a fallback — otherwise it silently bills us while looking to the user like their own account" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="60" y="465" width="620" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_16" value="&lt;b&gt;mode: &quot;shared&quot;&lt;/b&gt; — the server&#39;s trial key&lt;br&gt;&lt;br&gt;• deployment is &lt;b&gt;not&lt;/b&gt; caller-controlled — only SHARED_MODELS&lt;br&gt;&amp;nbsp;&amp;nbsp;(an open deployment field on our key is an invitation to bill us on the most expensive model in the resource)&lt;br&gt;• 5 requests per device, charged &lt;b&gt;before&lt;/b&gt; the model call — refunding on error turns the quota into a free retry loop" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDF1DE;strokeColor=#B45309;fontColor=#4A2A08;" parent="1" vertex="1">
                    <mxGeometry x="800" y="465" width="640" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_17" value="apiKey &amp;&amp; endpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" parent="1" source="m8-credentials_13" target="m8-credentials_15" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_18" value="neither" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#B45309;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" parent="1" source="m8-credentials_13" target="m8-credentials_16" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_19" value="&lt;b&gt;Device identity — two weak signals, deliberately&lt;/b&gt;&lt;br&gt;&lt;br&gt;1 · signed httpOnly cookie (HMAC-SHA256, timingSafeEqual) — survives restarts, dies with site data&lt;br&gt;2 · sha256(ip + user-agent + accept-language) — survives cookie clearing, collides behind one NAT&lt;br&gt;&lt;br&gt;Charged against &lt;b&gt;both&lt;/b&gt;, refused if &lt;b&gt;either&lt;/b&gt; is spent: biased toward false refusals rather than free rides. An honest user who collides supplies their own key and is unblocked." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="800" y="705" width="640" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#B45309;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="m8-credentials_16" target="m8-credentials_19" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_21" value="What a browser CANNOT do, stated because it gets asked:&lt;br&gt;&lt;br&gt;read a MAC address.  There is no web API for it and there&lt;br&gt;deliberately never has been — a hardware serial surviving&lt;br&gt;every reset is a permanent supercookie.  os.networkInterfaces()&lt;br&gt;on the server returns the SERVER&#39;s MAC, identical for every&lt;br&gt;visitor.&lt;br&gt;&lt;br&gt;So this is a speed bump, not a security control.  A private&lt;br&gt;window plus a VPN resets it, and that is acceptable: five&lt;br&gt;requests is not worth defending harder.  The real answer is&lt;br&gt;accounts, which the brief scopes out." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="60" y="705" width="620" height="212" as="geometry"/>
                </mxCell>
                <mxCell id="m8-credentials_22" value="&lt;b&gt;Isolation, in an MVP with exactly one tenant&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;tenant_id&lt;/i&gt; is a real column on &lt;b&gt;fact&lt;/b&gt; and a &lt;b&gt;required argument&lt;/b&gt; to compile() — it throws without one. Every emitter opens its WHERE clause with &lt;i&gt;tenant_id = $tenant&lt;/i&gt;, and the flag query carries it too. The value is &lt;i&gt;&quot;demo&quot;&lt;/i&gt;, passed from ask(), never from the model and never from the request body.&lt;br&gt;&lt;br&gt;That is the whole point of writing it now: a tenant filter retrofitted later is a filter someone forgets on one query path. The predicate is a no-op today and a load-bearing one the day auth exists — and the interface does not move.&lt;br&gt;&lt;br&gt;Known gaps, stated: trial counters are in-memory, so they reset on restart and a second instance grants a fresh allowance (UsageStore is an interface; Redis is a one-file swap). x-forwarded-for is client-settable and is treated as a hint, never as authentication." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDF1DE;strokeColor=#B45309;fontColor=#4A2A08;" parent="1" vertex="1">
                    <mxGeometry x="60" y="935" width="1380" height="180" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="m9-answer-contract" name="9 · The answer contract">
        <mxGraphModel dx="1932" dy="1712" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1160" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="m9-answer-contract_1" value="The answer contract — “show its work” as a type, not a convention" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#0F172A;fontSize=22;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="1200" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="m9-answer-contract_2" value="Every answer carries all of it. The UI abbreviates; it never omits. If a field cannot be produced, it is null and the status says why." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="40" y="60" width="1410" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="m9-answer-contract_3" value="interface Answer {&lt;br&gt;  status:         &quot;answered&quot; | &quot;refused&quot;&lt;br&gt;  interpretation: string      // one line, read first&lt;br&gt;  finding:        string      // &lt;= 3 sentences&lt;br&gt;  plan:           Plan        // what the model chose&lt;br&gt;  sql:            string|null // the query that ran&lt;br&gt;  result: {&lt;br&gt;    columns: readonly string[]&lt;br&gt;    rows:    readonly ResultRow[]&lt;br&gt;    range:   [string, string] | null&lt;br&gt;  } | null&lt;br&gt;  chart:  ChartSpec | null    // kind chosen by rule&lt;br&gt;  flags:  readonly Flag[]     // defects on THESE rows&lt;br&gt;  trace: {&lt;br&gt;    traceId, askedAt, question,&lt;br&gt;    provider: &quot;azure-openai&quot;, model,&lt;br&gt;    credentialMode: &quot;byok&quot; | &quot;shared&quot;,&lt;br&gt;    plannerPromptVersion, narratorPromptVersion,&lt;br&gt;    semanticVersion, policyVersion,&lt;br&gt;    planGrammarVersion, compilerVersion,&lt;br&gt;    dataVersion,                // coverage window&lt;br&gt;    latencyMs: { plan, query, narrate, total }&lt;br&gt;  }&lt;br&gt;}&lt;br&gt;&lt;br&gt;// src/agent/types.ts" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="60" y="150" width="620" height="470" as="geometry"/>
                </mxCell>
                <mxCell id="m9-answer-contract_4" value="&lt;b&gt;Interpreted as:&lt;/b&gt; …&lt;br&gt;the model wrote the “what”; the dates were appended by code, because the model does not know what its own relative range resolved to" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="740" y="150" width="700" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="m9-answer-contract_5" value="&lt;b&gt;The finding&lt;/b&gt;&lt;br&gt;2–3 sentences. Every numeral in it has been re-checked against the rows below." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="740" y="240" width="700" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="m9-answer-contract_6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="m9-answer-contract_4" target="m9-answer-contract_5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m9-answer-contract_7" value="&lt;b&gt;The chart&lt;/b&gt;&lt;br&gt;kind, x and y come from the server. Recharts only draws it, so the picture cannot disagree with the text." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="740" y="330" width="700" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="m9-answer-contract_8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="m9-answer-contract_5" target="m9-answer-contract_7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m9-answer-contract_9" value="&lt;b&gt;Flags&lt;/b&gt;&lt;br&gt;only the defects that touched these rows. A caveat on every answer is a caveat nobody reads." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="740" y="460" width="700" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="m9-answer-contract_10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="m9-answer-contract_7" target="m9-answer-contract_9" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m9-answer-contract_11" value="&lt;b&gt;Tabs: Rows | SQL | Plan&lt;/b&gt;&lt;br&gt;present on every answer but folded away — six open panels is a debugger, not a product. The SQL shown is the SQL that ran." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="740" y="570" width="700" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="m9-answer-contract_12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="m9-answer-contract_9" target="m9-answer-contract_11" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m9-answer-contract_13" value="&lt;b&gt;Trace footer&lt;/b&gt;&lt;br&gt;traceId · model · plan/query/narrate/total · semantic v1 · policy v1 · compiler v1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="740" y="700" width="700" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="m9-answer-contract_14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="m9-answer-contract_11" target="m9-answer-contract_13" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m9-answer-contract_15" value="&lt;b&gt;A refusal uses the same contract&lt;/b&gt;&lt;br&gt;status &quot;refused&quot;, finding from compose.refusal(), and sql / result / chart all null. The UI opens on the &lt;b&gt;Plan&lt;/b&gt; tab instead of &lt;b&gt;Rows&lt;/b&gt;, so the user can see that the model classified the question rather than that the system fell over." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDF1DE;strokeColor=#B45309;fontColor=#4A2A08;" parent="1" vertex="1">
                    <mxGeometry x="740" y="800" width="700" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="m9-answer-contract_16" value="&lt;b&gt;Why the whole contract, on every answer&lt;/b&gt;&lt;br&gt;&lt;br&gt;The brief&#39;s requirement is “show its work”. Making that a type rather than a debug flag has three consequences that matter:&lt;br&gt;&lt;br&gt;• the SQL in the response is the SQL that executed — there is no second explanation query that can drift from the real one;&lt;br&gt;• a disputed number is reproducible from the trace alone: same plan, same semantic version, same policy version, same coverage window;&lt;br&gt;• the golden runner and the UI consume the same object, so what the tests assert is what the user sees." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E8EBEF;strokeColor=#4A5568;fontColor=#1A202C;" parent="1" vertex="1">
                    <mxGeometry x="60" y="660" width="620" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="m9-answer-contract_17" value="Known gaps, in the order I would fix them: (1) no conversation memory — “what about Meta?” as a follow-up is not resolved against the previous question, and it is the most common real interaction; (2) diagnose_drop decomposes by channel only — campaign-level is a second CTE, not a redesign; (3) a failed request still spends a trial allowance; (4) ambiguity resolution is unmeasured — Layer 2 asserts plan shape and would not catch a drift in metric choice; (5) trial counts are in memory; (6) channel_outage cannot tell an outage from a channel that was simply not running." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="60" y="960" width="1380" height="90" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>