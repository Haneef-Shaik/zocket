                </mxCell>
                <mxCell id="m5-exits_18" value="&lt;b&gt;EXIT A · status &quot;refused&quot;&lt;/b&gt;&lt;br&gt;finding = compose.refusal(verdict, coverage)&lt;br&gt;sql null · result null · chart null · flags []&lt;br&gt;&lt;b&gt;the narrator is never called&lt;/b&gt; — narrate: 0 ms&lt;br&gt;5 reasons: no_such_entity · no_such_dimension ·&lt;br&gt;no_such_metric · outside_coverage · not_analytical" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDF1DE;strokeColor=#B45309;fontColor=#4A2A08;" parent="1" vertex="1">
                    <mxGeometry x="60" y="640" width="420" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="m5-exits_19" value="compile() → run() × 2" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="560" y="740" width="340" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="m5-exits_20" value="&lt;b&gt;500&lt;/b&gt; Internal error. (CompileError, DuckDB)&lt;br&gt;logged server-side, internals not leaked" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDE8E0;strokeColor=#C2410C;fontColor=#5A1D08;" parent="1" vertex="1">
