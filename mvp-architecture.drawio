    <diagram id="m3-canonical-model" name="3 · Boot and the canonical model">
        <mxGraphModel dx="1025" dy="856" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1320" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="m3-canonical-model_1" value="Boot and the canonical model — src/sql/views.sql" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#0F172A;fontSize=22;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="1200" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_2" value="Every policy in policies.ts becomes a line of SQL exactly once, here, upstream of every query. The agent reads one view: fact." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="40" y="60" width="1470" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_3" value="LLM call" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#EFE8FF;strokeColor=#7A4FD1;fontColor=#2B1A55;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="108" width="168" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_4" value="Deterministic code" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="218" y="108" width="168" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_5" value="Versioned definition" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDF1DE;strokeColor=#B45309;fontColor=#4A2A08;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="396" y="108" width="168" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_6" value="Stop / error exit" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDE8E0;strokeColor=#C2410C;fontColor=#5A1D08;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="574" y="108" width="168" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_7" value="Infrastructure" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E8EBEF;strokeColor=#4A5568;fontColor=#1A202C;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="752" y="108" width="168" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_8" value="&lt;b&gt;bootstrap()&lt;/b&gt; — once per process&lt;br&gt;DuckDBInstance.create(&quot;:memory:&quot;)&lt;br&gt;SET preserve_insertion_order = true; SET threads = 1;&lt;br&gt;extractStatements(views.sql) → run each in order&lt;br&gt;&lt;i&gt;src/db/duckdb.ts&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="60" y="170" width="420" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_9" value="connPromise ??= bootstrap()   // module-level singleton&lt;br&gt;coverage read once: SELECT * FROM coverage&lt;br&gt;&lt;br&gt;single-threaded + insertion order because the restatement&lt;br&gt;policy is &quot;last row in FILE ORDER wins&quot; — _ord must mean&lt;br&gt;something. tests/ingest.test.ts is the tripwire." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="510" y="170" width="480" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_10" value="&lt;b&gt;Why in-process DuckDB&lt;/b&gt;&lt;br&gt;The interface — a &lt;i&gt;fact&lt;/i&gt; view plus a coverage window — is what survives contact with Snowflake or BigQuery. The compiler emits SQL either way, so the trust boundary does not move when the warehouse does." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E8EBEF;strokeColor=#4A5568;fontColor=#1A202C;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="170" width="480" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_11" value="&lt;b&gt;data/*.csv&lt;/b&gt;&lt;br&gt;&lt;br&gt;ad_performance_daily.csv&lt;br&gt;2364 rows&lt;br&gt;&lt;br&gt;campaigns.csv&lt;br&gt;creatives.csv&lt;br&gt;fx_rates.csv" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E8EBEF;strokeColor=#4A5568;fontColor=#1A202C;" parent="1" vertex="1">
                    <mxGeometry x="60" y="340" width="220" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_12" value="&lt;b&gt;raw_perf&lt;/b&gt; (TABLE)&lt;br&gt;row_number() OVER () AS _ord&lt;br&gt;all_varchar = true" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="340" y="340" width="250" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_13" value="&lt;b&gt;perf_typed&lt;/b&gt;&lt;br&gt;TRY_CAST, not CAST — a malformed&lt;br&gt;number becomes NULL and is counted,&lt;br&gt;rather than aborting the answer" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="340" y="460" width="250" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_14" value="&lt;b&gt;perf_exact_dedup&lt;/b&gt;&lt;br&gt;GROUP BY ALL, MIN(_ord)&lt;br&gt;an exact re-send is the same fact twice" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="340" y="600" width="250" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_15" value="&lt;b&gt;perf_resolved&lt;/b&gt;&lt;br&gt;row_number() OVER (PARTITION BY&lt;br&gt;date, campaign_id, creative_id&lt;br&gt;ORDER BY _ord DESC) = 1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="340" y="720" width="250" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_16" value="&lt;b&gt;campaigns · creatives&lt;/b&gt;&lt;br&gt;trimmed, upper-cased ids,&lt;br&gt;typed dates and budgets" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="650" y="340" width="260" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_17" value="&lt;b&gt;fx_typed&lt;/b&gt;&lt;br&gt;date · currency · rate_to_usd" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="650" y="480" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_18" value="&lt;b&gt;fx_spine&lt;/b&gt;&lt;br&gt;a dense date × currency grid,&lt;br&gt;last_value(… IGNORE NULLS) OVER …&lt;br&gt;+ rate_carried_forward flag" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="650" y="600" width="260" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_19" value="&lt;b&gt;fact&lt;/b&gt; — the one view every query reads&lt;br&gt;&lt;br&gt;tenant_id (&#39;demo&#39;, a real column)&lt;br&gt;campaign_name · channel · objective&lt;br&gt;creative_name · format · daily_budget&lt;br&gt;spend_usd = spend × rate_to_usd&lt;br&gt;revenue_usd = revenue × rate_to_usd&lt;br&gt;&lt;br&gt;+ 8 row-level defect markers:&lt;br&gt;is_unmapped_campaign · is_unmapped_creative&lt;br&gt;is_currency_mismatch · is_funnel_violation&lt;br&gt;is_negative_spend · is_revenue_without_spend&lt;br&gt;is_after_campaign_end · has_null_measure" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="990" y="470" width="330" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_20" value="&lt;b&gt;coverage&lt;/b&gt;&lt;br&gt;MIN(date) · MAX(date) · COUNT(*)&lt;br&gt;2026-06-08 .. 2026-09-04 · 2341" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDF1DE;strokeColor=#B45309;fontColor=#4A2A08;" parent="1" vertex="1">
                    <mxGeometry x="990" y="810" width="330" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_21" value="read_csv" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="m3-canonical-model_11" target="m3-canonical-model_12" edge="1">
