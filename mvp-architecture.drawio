                <mxCell id="m2-request-path_22" value="BIGINT -&gt; number (JSON.stringify throws on BigInt), DATE -&gt; ISO string&lt;br&gt;flags[] built from the resolver (partial_day, coverage_clipped)&lt;br&gt;        and from 12 row-level markers counted over THESE rows only" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
