                <mxCell id="m2-request-path_44" value="Latency is ~99% model. DuckDB over 2,341 rows rounds to nothing, which is why the trace splits plan / query / narrate from day one: the first optimisation is prompt caching on the planner system prompt, and the trace is what makes that measurable rather than assumed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1938" width="1520" height="60" as="geometry"/>
                </mxCell>
            </root>
