                <mxCell id="m2-request-path_25" value="&lt;b&gt;12 · narrate()&lt;/b&gt; — LLM call 2&lt;br&gt;verified rows → prose&lt;br&gt;&lt;i&gt;src/agent/narrator.ts&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#EFE8FF;strokeColor=#7A4FD1;fontColor=#2B1A55;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1549" width="360" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="m2-request-path_26" value="sees: the table (first 60 rows, rounded) + the flag lines. Nothing else.&lt;br&gt;cannot query, cannot recompute, never sees a raw data row.&lt;br&gt;&quot;Meta took the largest share at $162.5k of $398.3k over the window…&quot;   ~5s" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
