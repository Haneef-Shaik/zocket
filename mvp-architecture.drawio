                </mxCell>
                <mxCell id="m3-canonical-model_29" value="campaign owns the currency" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" parent="1" source="m3-canonical-model_16" target="m3-canonical-model_19" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_30" value="ON date AND currency" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" parent="1" source="m3-canonical-model_18" target="m3-canonical-model_19" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#B45309;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="m3-canonical-model_19" target="m3-canonical-model_20" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_32" value="POLICIES.collapseExactDuplicates  true            August conversions: 5,584 — querying raw rows gives 5,650&lt;br&gt;POLICIES.restatement              last_write_wins same key, new numbers = a restatement, not a duplicate&lt;br&gt;POLICIES.currencySource           &quot;campaign&quot;      trusting the row column adds ~$63k of phantom spend&lt;br&gt;POLICIES.fxGapPolicy              &quot;carry_forward&quot; dropping loses spend; defaulting to 1.0 converts INR at ~90×&lt;br&gt;POLICIES.orphanPolicy             &quot;report_separately&quot;  unmapped: $1,834.25 kept under its own label&lt;br&gt;POLICIES.nullPolicy               &quot;preserve&quot;      nulls stay null, never coerced to 0&lt;br&gt;POLICIES.partialFinalDay          true            2026-09-04 is an incomplete load" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#F3FAF9;strokeColor=#A8D3CC;fontColor=#08302C;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="60" y="880" width="900" height="128" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_33" value="&lt;b&gt;The judgement that changes a number&lt;/b&gt;&lt;br&gt;Each policy above has a defensible alternative that produces a &lt;i&gt;different&lt;/i&gt; answer. That is exactly why it is a reviewed constant with a named test, and not a sentence in a prompt." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDF1DE;strokeColor=#B45309;fontColor=#4A2A08;" parent="1" vertex="1">
                    <mxGeometry x="990" y="940" width="330" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="m3-canonical-model_34" value="Three of these are only visible because the pipeline is staged: duplicates_collapsed and restatement_applied are counted by differencing perf_typed → perf_exact_dedup → perf_resolved, because by the time a row reaches fact the duplicate is gone — and that is the point." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1018" width="900" height="78" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
