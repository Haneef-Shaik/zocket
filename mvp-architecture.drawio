                <mxCell id="m6-barriers_46" value="“turn off linkedin_thought_leadership” — an awareness campaign at ROAS 0.00 that was never bought for revenue; or by CPA, one of the most profitable" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="790" y="801" width="480" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="m6-barriers_47" value="golden q4_which_to_turn_off" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="1270" y="801" width="250" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="m6-barriers_48" value="&lt;b&gt;Fail closed, and fail loudly.&lt;/b&gt; Barrier 2 duplicates what structured output already guarantees. That is deliberate: if the zod schema and the catalogue ever drift apart, the mismatch surfaces as a named refusal rather than as SQL over a column that does not exist." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E8EBEF;strokeColor=#4A5568;fontColor=#1A202C;" parent="1" vertex="1">
                    <mxGeometry x="40" y="913" width="740" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="m6-barriers_49" value="&lt;b&gt;What is NOT a barrier:&lt;/b&gt; asking the model to double-check itself. Every check above is ordinary code over the same rows the user is shown. A second opinion from the same distribution is not verification — it is a correlated failure wearing a second hat." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E8EBEF;strokeColor=#4A5568;fontColor=#1A202C;" parent="1" vertex="1">
                    <mxGeometry x="800" y="913" width="720" height="96" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="m7-the-check" name="7 · The automated check">
        <mxGraphModel dx="966" dy="856" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1320" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="m7-the-check_1" value="The automated check — two layers over one seam" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#0F172A;fontSize=22;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="1200" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_2" value="“Does the agent still answer correctly after I change something?” splits into two questions with different costs, so it is two test layers over the same function." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="40" y="60" width="1470" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_3" value="LLM call" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#EFE8FF;strokeColor=#7A4FD1;fontColor=#2B1A55;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="108" width="168" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_4" value="Deterministic code" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="218" y="108" width="168" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_5" value="Versioned definition" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDF1DE;strokeColor=#B45309;fontColor=#4A2A08;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="396" y="108" width="168" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_6" value="Stop / error exit" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDE8E0;strokeColor=#C2410C;fontColor=#5A1D08;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="574" y="108" width="168" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_7" value="Infrastructure" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E8EBEF;strokeColor=#4A5568;fontColor=#1A202C;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="752" y="108" width="168" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_8" value="&lt;b&gt;execute(plan, coverage, tenantId)&lt;/b&gt;&lt;br&gt;validate → compile → run → validate → chart&lt;br&gt;&lt;i&gt;src/agent/execute.ts&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="560" y="175" width="420" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_9" value="The seam exists so the check runs over exactly the code the API runs — not a reimplementation that can quietly agree with itself while both are wrong." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="560" y="285" width="420" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_10" value="&lt;b&gt;Layer 1 · deterministic&lt;/b&gt; — &lt;i&gt;npm test&lt;/i&gt;&lt;br&gt;&lt;br&gt;Each golden case&#39;s &lt;b&gt;expected plan&lt;/b&gt; is fed straight to execute(). No LLM, no API key, no network, no flake.&lt;br&gt;&lt;br&gt;&lt;b&gt;108 passing assertions&lt;/b&gt; across 10 files, in seconds, for free.&lt;br&gt;&lt;br&gt;This is the layer that catches the regressions that actually corrupt answers: a changed dedup rule, a dropped FX join, a broken coverage clip." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="80" y="360" width="620" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_11" value="&lt;b&gt;Layer 2 · the planner&lt;/b&gt; — &lt;i&gt;GOLDEN_LLM=1 npm run test:llm&lt;/i&gt;&lt;br&gt;&lt;br&gt;Runs the real model over all 12 questions and asserts the &lt;b&gt;plan shape&lt;/b&gt; — type, metrics, resolved window — never the prose. Prose is not a regression surface; a plan is.&lt;br&gt;&lt;br&gt;&lt;b&gt;Scores 12/12&lt;/b&gt; on the current prompt.&lt;br&gt;&lt;br&gt;Opt-in, because it costs money and can flake on a provider hiccup. Keeping it out of the default run is what lets &lt;i&gt;npm test&lt;/i&gt; stay free — and therefore actually run." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#EFE8FF;strokeColor=#7A4FD1;fontColor=#2B1A55;" parent="1" vertex="1">
                    <mxGeometry x="840" y="360" width="620" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_12" value="expected plan in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" parent="1" source="m7-the-check_8" target="m7-the-check_10" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#7A4FD1;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" parent="1" source="m7-the-check_8" target="m7-the-check_11" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_14" value="examples/golden.jsonl — one case per line, 12 cases&lt;br&gt;{&lt;br&gt;  &quot;id&quot;: &quot;t6_august_conversions_dedup&quot;,&lt;br&gt;  &quot;question&quot;: &quot;How many conversions did we get in August?&quot;,&lt;br&gt;  &quot;agent_plan&quot;: { ... the plan a correct planner emits ... },&lt;br&gt;  &quot;expect&quot;: {&lt;br&gt;    &quot;values&quot;: { &quot;conversions&quot;: 5584 },&lt;br&gt;    &quot;tolerance_pct&quot;: 0.1,&lt;br&gt;    &quot;must_flag&quot;: [&quot;duplicates_collapsed&quot;],&lt;br&gt;    &quot;guard&quot;: &quot;querying raw rows returns 5650, inflated by&lt;br&gt;              66 re-sent duplicate rows&quot;&lt;br&gt;  }&lt;br&gt;}" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="80" y="650" width="620" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_15" value="&lt;b&gt;“guard” is the field that makes this a check and not a snapshot&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;expected 5584, got 5650&lt;/i&gt; tells you a number moved.&lt;br&gt;&lt;i&gt;this is the case that prevents: inflated by 66 re-sent duplicate rows&lt;/i&gt; tells you which policy you just broke.&lt;br&gt;&lt;br&gt;Every failure message quotes it. A golden set whose failures do not name the wrong answer they were written to catch decays into a set of numbers people re-bless.&lt;br&gt;&lt;br&gt;Tolerance is &lt;i&gt;max(relative %, half the last written digit)&lt;/i&gt; — 1% of 0.2 would demand four digits of agreement from a figure only ever written to one." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDF1DE;strokeColor=#B45309;fontColor=#4A2A08;" parent="1" vertex="1">
                    <mxGeometry x="840" y="650" width="620" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="m7-the-check_16" value="the 12 cases — and the wrong answer each one exists to prevent" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E8EBEF;strokeColor=#4A5568;fontColor=#1A202C;fontStyle=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="80" y="940" width="1380" height="40" as="geometry"/>
