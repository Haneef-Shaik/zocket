                <mxCell id="m6-barriers_40" value="a numeral in the prose that is not on the table" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="490" y="713" width="300" height="88" as="geometry"/>
