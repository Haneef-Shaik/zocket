# ---------------------------------------------------------------- Azure OpenAI
# The shared "trial" credentials. Requests that use these are metered per device
# (see TRIAL_REQUEST_LIMIT). Callers who supply their own key in the UI bypass
# all of it -- their key is used for that request only and never stored.
#
# The deterministic core (validator -> compiler -> DuckDB -> result validator)
# runs without any of this, and so does `npm test`.

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# Azure deployment name for the default model. NOTE: deployment names are chosen
# by you when you create the deployment in Azure and are frequently NOT the same
# as the underlying model name.
AZURE_OPENAI_DEPLOYMENT=gpt6-sol

# Structured outputs (response_format: json_schema) need 2024-08-01-preview or later.
AZURE_OPENAI_API_VERSION=2024-10-21

# ------------------------------------------------------------------ Trial quota
# Requests allowed per device on the shared key above.
TRIAL_REQUEST_LIMIT=5

# Optional rolling window in hours. Unset = a lifetime trial allowance.
# TRIAL_WINDOW_HOURS=24

# Signs the device cookie so an id cannot be forged. Unset means an ephemeral
# secret is generated at boot and every restart resets everyone's allowance.
# Generate with: openssl rand -hex 32
DEVICE_ID_SECRET=

# ------------------------------------------------------------------------- data
# DASHBOARD_AGENT_DATA=./data
