                <mxCell id="n15" value="Answer" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E8EBEF;strokeColor=#4A5568;fontColor=#1A202C;rounded=1;arcSize=40;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="505" width="150" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n16" value="&lt;b&gt;What B leaves the model&lt;/b&gt;  —  choosing a name from a fixed list." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;align=left;fontSize=11;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="80" y="600" width="1170" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#C2410C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="n5" target="n6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e18" value="free-form SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#C2410C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="n6" target="n7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#C2410C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="n7" target="n8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="n10" target="n11" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e21" value="typed plan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="n11" target="n12" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e22" value="verdict" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="n12" target="n13" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e23" value="parameterised SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="n13" target="n14" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="n14" target="n15" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="t25" value="The cost of B is real: a semantic layer and a compiler have to exist, and a question outside the plan grammar is refused rather than attempted. That is the trade — a narrower system that is right, over a wider one that is sometimes confidently wrong. For the MVP, constrained SQL generation would be faster to build; production should not keep it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="60" y="710" width="1340" height="70" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
