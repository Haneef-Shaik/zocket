    <diagram id="6-data-architecture" name="6 · Data architecture">
        <mxGraphModel dx="1368" dy="977" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1420" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t1" value="Data architecture and the canonical model" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#0F172A;fontSize=22;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="1000" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="t2" value="Every join, FX conversion and dedup rule is implemented exactly once, upstream of every query. The agent reads one view." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="40" y="60" width="1100" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="SOURCE EXTRACT · immutable, kept for audit" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#F7F8FA;strokeColor=#CBD5E0;verticalAlign=top;align=center;fontColor=#64748B;fontSize=13;fontStyle=1;spacingTop=8;dashed=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="120" width="1420" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="TYPING · defects become visible, not fatal" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#F7F8FA;strokeColor=#CBD5E0;verticalAlign=top;align=center;fontColor=#64748B;fontSize=13;fontStyle=1;spacingTop=8;dashed=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="300" width="1420" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="POLICY · every rule applied exactly once" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#F7F8FA;strokeColor=#CBD5E0;verticalAlign=top;align=center;fontColor=#64748B;fontSize=13;fontStyle=1;spacingTop=8;dashed=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="500" width="1420" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="ad_performance_daily.csv&lt;br&gt;2364 rows" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E8EBEF;strokeColor=#4A5568;fontColor=#1A202C;rounded=1;arcSize=40;" parent="1" vertex="1">
                    <mxGeometry x="70" y="165" width="320" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n7" value="campaigns.csv&lt;br&gt;12 rows" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E8EBEF;strokeColor=#4A5568;fontColor=#1A202C;rounded=1;arcSize=40;" parent="1" vertex="1">
                    <mxGeometry x="430" y="165" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n8" value="creatives.csv&lt;br&gt;31 rows" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E8EBEF;strokeColor=#4A5568;fontColor=#1A202C;rounded=1;arcSize=40;" parent="1" vertex="1">
                    <mxGeometry x="770" y="165" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n9" value="fx_rates.csv&lt;br&gt;184 rows · USD, INR" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E8EBEF;strokeColor=#4A5568;fontColor=#1A202C;rounded=1;arcSize=40;" parent="1" vertex="1">
                    <mxGeometry x="1110" y="165" width="310" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n10" value="&lt;b&gt;perf_typed&lt;/b&gt;&lt;br&gt;TRY_CAST, not CAST: a malformed number&lt;br&gt;becomes NULL and is counted in the flags,&lt;br&gt;rather than aborting the whole answer" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="70" y="345" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n11" value="&lt;b&gt;campaigns · creatives&lt;/b&gt;&lt;br&gt;trimmed, upper-cased keys" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="430" y="345" width="640" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n12" value="&lt;b&gt;fx_typed&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="1110" y="345" width="310" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n13" value="&lt;b&gt;perf_exact_dedup&lt;/b&gt;&lt;br&gt;an identical re-send is the same fact twice — collapse it" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="70" y="545" width="460" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="n14" value="&lt;b&gt;perf_resolved&lt;/b&gt;&lt;br&gt;same key, different numbers is a restatement — last row in file order wins" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="70" y="630" width="460" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="n15" value="&lt;b&gt;fx_spine&lt;/b&gt;&lt;br&gt;date × currency grid.&lt;br&gt;Dropping rows with no rate loses real spend;&lt;br&gt;defaulting to 1.0 converts INR at ~90×.&lt;br&gt;Carry the last known rate forward, and flag it." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="545" width="420" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="n16" value="fact  —  the one view every query reads&lt;br&gt;&lt;br&gt;tenant_id · date · campaign_id · creative_id&lt;br&gt;campaign_name · channel · objective&lt;br&gt;creative_name · format&lt;br&gt;&lt;br&gt;impressions · clicks · conversions&lt;br&gt;currency · spend · revenue&lt;br&gt;&lt;br&gt;rate_to_usd · rate_carried_forward&lt;br&gt;spend_usd    = spend   × rate_to_usd&lt;br&gt;revenue_usd  = revenue × rate_to_usd&lt;br&gt;&lt;br&gt;+ 8 row-level defect markers&lt;br&gt;  is_unmapped_campaign      is_currency_mismatch&lt;br&gt;  is_unmapped_creative      is_funnel_violation&lt;br&gt;  is_negative_spend         is_after_campaign_end&lt;br&gt;  is_revenue_without_spend  has_null_measure" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#D6EBE7;strokeColor=#0E6E63;strokeWidth=3;fontColor=#08302C;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacingLeft=16;spacingTop=12;" parent="1" vertex="1">
                    <mxGeometry x="450" y="770" width="620" height="370" as="geometry"/>
                </mxCell>
                <mxCell id="n17" value="&lt;b&gt;coverage&lt;/b&gt;&lt;br&gt;as_of comes from here,&lt;br&gt;never from the wall clock" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDF1DE;strokeColor=#B45309;fontColor=#4A2C05;" parent="1" vertex="1">
                    <mxGeometry x="160" y="1210" width="380" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n18" value="&lt;b&gt;Semantic catalogue&lt;/b&gt;&lt;br&gt;metric SQL selects from fact" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDF1DE;strokeColor=#B45309;fontColor=#4A2C05;" parent="1" vertex="1">
                    <mxGeometry x="570" y="1210" width="380" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n19" value="&lt;b&gt;Data-quality flags&lt;/b&gt;&lt;br&gt;counted over the queried window,&lt;br&gt;not the whole extract" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDF1DE;strokeColor=#B45309;fontColor=#4A2C05;" parent="1" vertex="1">
                    <mxGeometry x="980" y="1210" width="380" height="90" as="geometry"/>
                </mxCell>
