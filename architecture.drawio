                <mxCell id="n10" value="Question" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E8EBEF;strokeColor=#4A5568;fontColor=#1A202C;rounded=1;arcSize=40;" parent="1" vertex="1">
