                </mxCell>
                <mxCell id="n25" value="Retry, then fall back to a template finding&lt;br&gt;&lt;br&gt;Same verified numbers, plainer words.&lt;br&gt;Losing the narrator costs style, nothing else." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDE8E0;strokeColor=#C2410C;fontColor=#4A1A05;align=left;verticalAlign=top;fontSize=11;spacingLeft=14;spacingTop=10;" parent="1" vertex="1">
