    <diagram id="3-the-plan-grammar" name="3 · The plan grammar">
        <mxGraphModel dx="1368" dy="977" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t1" value="The plan grammar — the model&#39;s entire surface" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#0F172A;fontSize=22;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="1000" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="t2" value="The planner LLM controls this and nothing else. It never writes SQL, and anything not expressible here is refused rather than improvised." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="40" y="60" width="1100" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="&lt;b&gt;single_value&lt;/b&gt;&lt;br&gt;&lt;i&gt;“What was our ROAS last quarter?”&lt;/i&gt;&lt;br&gt;&lt;br&gt;metrics [1+]&lt;br&gt;time_range&lt;br&gt;filters []" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;align=left;verticalAlign=top;fontSize=12;spacingLeft=14;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="60" y="150" width="420" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="&lt;b&gt;breakdown&lt;/b&gt;&lt;br&gt;&lt;i&gt;“Spend by channel.”&lt;/i&gt;&lt;br&gt;&lt;br&gt;metrics [1+]&lt;br&gt;dimensions [1–2]&lt;br&gt;time_range · filters []" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;align=left;verticalAlign=top;fontSize=12;spacingLeft=14;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="520" y="150" width="420" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="&lt;b&gt;ranking&lt;/b&gt;&lt;br&gt;&lt;i&gt;“Which campaign made the most revenue?”&lt;/i&gt;&lt;br&gt;&lt;br&gt;metrics [1+] · dimensions [1]&lt;br&gt;order_by · direction&lt;br&gt;limit ≤ 50" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;align=left;verticalAlign=top;fontSize=12;spacingLeft=14;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="980" y="150" width="420" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="&lt;b&gt;time_series&lt;/b&gt;&lt;br&gt;&lt;i&gt;“Show me daily conversions.”&lt;/i&gt;&lt;br&gt;&lt;br&gt;metrics [1+] · time_range&lt;br&gt;grain: day | week | month&lt;br&gt;dimensions [0–1]" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;align=left;verticalAlign=top;fontSize=12;spacingLeft=14;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="60" y="400" width="420" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="n7" value="&lt;b&gt;compare_periods&lt;/b&gt;&lt;br&gt;&lt;i&gt;“How did last week compare to the week before?”&lt;/i&gt;&lt;br&gt;&lt;br&gt;metrics [1+] · time_range&lt;br&gt;comparison (a second range)&lt;br&gt;dimensions [0–1]" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;align=left;verticalAlign=top;fontSize=12;spacingLeft=14;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="520" y="400" width="420" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="n8" value="&lt;b&gt;diagnose_drop&lt;/b&gt;&lt;br&gt;&lt;i&gt;“Conversions fell off a cliff — what happened?”&lt;/i&gt;&lt;br&gt;&lt;br&gt;metric · target_date&lt;br&gt;baseline_days ≤ 90&lt;br&gt;&lt;br&gt;A fixed template. It always counts rows on&lt;br&gt;both sides — that is what separates&lt;br&gt;“performance dropped” from “the load was&lt;br&gt;incomplete”, and the model is not trusted&lt;br&gt;to remember to ask." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;align=left;verticalAlign=top;fontSize=12;spacingLeft=14;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="980" y="400" width="420" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="n9" value="&lt;b&gt;turn_off_candidate&lt;/b&gt;&lt;br&gt;&lt;i&gt;“Which campaign should we turn off?”&lt;/i&gt;&lt;br&gt;&lt;br&gt;no fields&lt;br&gt;&lt;br&gt;TURN_OFF_POLICY supplies the eligibility&lt;br&gt;criteria. Model-selected shape,&lt;br&gt;policy-supplied thresholds." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;align=left;verticalAlign=top;fontSize=12;spacingLeft=14;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="60" y="650" width="420" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="n10" value="&lt;b&gt;budget_pacing&lt;/b&gt;&lt;br&gt;&lt;i&gt;“Are we pacing to budget?”&lt;/i&gt;&lt;br&gt;&lt;br&gt;time_range&lt;br&gt;&lt;br&gt;Answered in campaign-native currency:&lt;br&gt;budgets are set in it." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;align=left;verticalAlign=top;fontSize=12;spacingLeft=14;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="520" y="650" width="420" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="n11" value="&lt;b&gt;unanswerable&lt;/b&gt;&lt;br&gt;&lt;i&gt;“How does our spend compare to competitors?”&lt;/i&gt;&lt;br&gt;&lt;br&gt;reason:  no_such_entity | no_such_dimension&lt;br&gt;         no_such_metric | outside_coverage&lt;br&gt;         not_analytical&lt;br&gt;missing: what the user would need, in their words&lt;br&gt;&lt;br&gt;The model may propose this. The validator&lt;br&gt;can also force it." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDE8E0;strokeColor=#C2410C;fontColor=#4A1A05;align=left;verticalAlign=top;fontSize=12;spacingLeft=14;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="980" y="650" width="420" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="t12" value="Structured output means the model cannot emit a metric or dimension name that is not in the catalogue. The validator re-checks anyway: a mismatch there means the schema and the catalogue have drifted apart — a bug, caught loudly rather than compiled into SQL." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="60" y="910" width="1340" height="50" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="4-where-a-wrong-answer-is-stopped" name="4 · Where a wrong answer is stopped">
        <mxGraphModel dx="1368" dy="977" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1360" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t1" value="Where a wrong answer is stopped" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#0F172A;fontSize=22;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="1000" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="t2" value="Each barrier catches a distinct class of defect. None of them asks the model to check its own work. The system fails closed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="40" y="60" width="1100" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="Question" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E8EBEF;strokeColor=#4A5568;fontColor=#1A202C;rounded=1;arcSize=40;" parent="1" vertex="1">
                    <mxGeometry x="210" y="130" width="240" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="&lt;b&gt;1 · Grammar&lt;/b&gt;&lt;br&gt;does the plan parse against the schema?" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;align=center;" parent="1" vertex="1">
                    <mxGeometry x="120" y="215" width="420" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="Retry once, then refuse&lt;br&gt;&lt;br&gt;A mismatch means the schema and the&lt;br&gt;catalogue have drifted apart." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDE8E0;strokeColor=#C2410C;fontColor=#4A1A05;align=left;verticalAlign=top;fontSize=11;spacingLeft=14;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="640" y="215" width="500" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="n3" target="n4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n8" value="&lt;b&gt;2 · Answerability&lt;/b&gt;&lt;br&gt;do the metric, dimension, entity&lt;br&gt;and window all exist?" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;align=center;" parent="1" vertex="1">
                    <mxGeometry x="120" y="385" width="420" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n9" value="REFUSED, with a reason&lt;br&gt;&lt;br&gt;no_such_metric · no_such_dimension&lt;br&gt;no_such_entity · outside_coverage&lt;br&gt;not_analytical" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDE8E0;strokeColor=#C2410C;fontColor=#4A1A05;align=left;verticalAlign=top;fontSize=11;spacingLeft=14;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="640" y="385" width="500" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="e11" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="n4" target="n8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n12" value="&lt;b&gt;3 · Authorisation&lt;/b&gt;&lt;br&gt;is the tenant predicate bound&lt;br&gt;by the compiler?" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;align=center;" parent="1" vertex="1">
                    <mxGeometry x="120" y="555" width="420" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n13" value="Compile error&lt;br&gt;&lt;br&gt;Never reaches the database. The predicate is&lt;br&gt;not a filter someone can forget on one path." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDE8E0;strokeColor=#C2410C;fontColor=#4A1A05;align=left;verticalAlign=top;fontSize=11;spacingLeft=14;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="640" y="555" width="500" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="e15" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="n8" target="n12" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n16" value="&lt;b&gt;4 · Compilation&lt;/b&gt;&lt;br&gt;parameterised, read-only,&lt;br&gt;row limit applied?" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;align=center;" parent="1" vertex="1">
                    <mxGeometry x="120" y="725" width="420" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n17" value="Do not execute" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDE8E0;strokeColor=#C2410C;fontColor=#4A1A05;align=left;verticalAlign=top;fontSize=11;spacingLeft=14;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="640" y="725" width="500" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="e19" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="n12" target="n16" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n20" value="&lt;b&gt;5 · Result validation&lt;/b&gt;&lt;br&gt;schema, types, nullability,&lt;br&gt;funnel invariants" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;align=center;" parent="1" vertex="1">
                    <mxGeometry x="120" y="895" width="420" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n21" value="Do not present an unsupported result&lt;br&gt;&lt;br&gt;Degraded, not failed → answer carries flags:&lt;br&gt;carried-forward FX · unmapped rows&lt;br&gt;currency mismatch · funnel violation" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FEF6E7;strokeColor=#B45309;fontColor=#4A2C05;align=left;verticalAlign=top;fontSize=11;spacingLeft=14;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="640" y="895" width="500" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="e23" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="n16" target="n20" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n24" value="&lt;b&gt;6 · Narrator guard&lt;/b&gt;&lt;br&gt;is every numeral in the prose&lt;br&gt;present in the result?" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;align=center;" parent="1" vertex="1">
