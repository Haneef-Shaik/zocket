                <mxCell id="n14" value="Database" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E8EBEF;strokeColor=#4A5568;fontColor=#1A202C;" parent="1" vertex="1">
                    <mxGeometry x="880" y="495" width="170" height="80" as="geometry"/>
