                    <mxGeometry x="440" y="565" width="1060" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="n11" value="&lt;b&gt;SQL compiler&lt;/b&gt;&lt;br&gt;plan → SQL. The model writes none of this." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="60" y="720.5" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="n12" value="SELECT channel, SUM(spend_usd) AS spend_usd&lt;br&gt;FROM   fact&lt;br&gt;WHERE  tenant_id = ?                     -- bound by the compiler&lt;br&gt;  AND  date BETWEEN ? AND ?&lt;br&gt;GROUP  BY channel&lt;br&gt;ORDER  BY spend_usd DESC&lt;br&gt;LIMIT  ?" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="440" y="696" width="1060" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="n13" value="&lt;b&gt;Warehouse&lt;/b&gt;&lt;br&gt;execute, read-only" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="60" y="874" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="n14" value="channel          spend_usd&lt;br&gt;meta            162,489.73&lt;br&gt;youtube          98,384.17&lt;br&gt;google_search    82,443.24&lt;br&gt;linkedin         53,112.19&lt;br&gt;unmapped          1,834.25   ← orphan rows kept, not silently dropped" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="440" y="857" width="1060" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="n15" value="&lt;b&gt;Result validator&lt;/b&gt;&lt;br&gt;schema, invariants, data-quality flags" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1027.5" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="n16" value="1,511 rows read over the window&lt;br&gt;clicks &lt;= impressions      ok&lt;br&gt;conversions &lt;= clicks      3 violations, flagged&lt;br&gt;fx rate carried forward    91 rows&lt;br&gt;unmapped campaign           5 rows&lt;br&gt;currency mismatch           2 rows&lt;br&gt;null measure                8 rows" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1003" width="1060" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="n17" value="&lt;b&gt;Chart selection&lt;/b&gt;&lt;br&gt;by rule, from the plan shape" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1164" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="n18" value="breakdown + 1 dimension + 1 measure&lt;br&gt;  →  { kind: &quot;bar&quot;, x: &quot;channel&quot;, y: &quot;spend_usd&quot; }" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1164" width="1060" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="n19" value="&lt;b&gt;LLM call 2 · narrator&lt;/b&gt;&lt;br&gt;verified rows → prose" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#EFE8FF;strokeColor=#7A4FD1;fontColor=#2B1A55;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1276" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="n20" value="&quot;Meta took the largest share of spend over the last eight weeks at&lt;br&gt; $162,489.73, ahead of YouTube at $98,384.17. $1,834.25 sits against&lt;br&gt; campaigns missing from the campaign table.&quot;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1276" width="1060" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="n21" value="&lt;b&gt;Narrator guard&lt;/b&gt;&lt;br&gt;every numeral checked against the result" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1397.5" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="n22" value="extracted   162,489.73 · 98,384.17 · 1,834.25&lt;br&gt;supported   3 of 3   →  pass&lt;br&gt;&lt;br&gt;a figure with no support fails the draft, not the answer: the finding&lt;br&gt;falls back to a template over the same verified numbers" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1388" width="1060" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="n23" value="&lt;b&gt;Answer&lt;/b&gt;&lt;br&gt;finding · chart · table · SQL · trace" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1521" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="n24" value="status   answered&lt;br&gt;flags    fx_rate_carried_forward (info) · funnel_violation (warn)&lt;br&gt;trace    planner-v1 · narrator-v1 · semantic v1 · policy v1&lt;br&gt;         plan grammar v1 · compiler v1 · data 2026-06-08..2026-09-04" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1519" width="1060" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="n3" target="n5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
