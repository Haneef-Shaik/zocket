    <diagram id="5-answerability-states" name="5 · Answerability states">
        <mxGraphModel dx="1368" dy="977" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="940" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t1" value="Answerability is a return value, not a prompt instruction" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#0F172A;fontSize=22;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="1000" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="t2" value="“I don&#39;t know” is a state with a reason code, reached by deterministic code before any query runs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="40" y="60" width="1100" height="40" as="geometry"/>
