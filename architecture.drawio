                <mxCell id="t1" value="Query strategy — why the plan, not the SQL" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#0F172A;fontSize=22;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="1000" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="t2" value="The two options differ by exactly where the trust boundary sits. Option A puts the database on the far side of the model." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="40" y="60" width="1100" height="40" as="geometry"/>
