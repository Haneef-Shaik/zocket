                <mxCell id="n5" value="&lt;b&gt;REFUSED&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDE8E0;strokeColor=#C2410C;fontColor=#4A1A05;" parent="1" vertex="1">
                    <mxGeometry x="100" y="370" width="440" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="no_such_entity&lt;br&gt;    “How does our spend compare to competitors?”&lt;br&gt;no_such_dimension&lt;br&gt;no_such_metric&lt;br&gt;outside_coverage&lt;br&gt;    the window falls outside 2026-06-08 .. 2026-09-04&lt;br&gt;not_analytical" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDE8E0;strokeColor=#C2410C;fontColor=#4A1A05;align=left;verticalAlign=top;fontSize=11;spacingLeft=14;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="100" y="460" width="440" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="n7" value="Composed refusal — names the missing thing.&lt;br&gt;No model prose: the one question where a model&lt;br&gt;filling the silence would be most convincing&lt;br&gt;is the one where it would be most wrong." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;align=left;verticalAlign=top;fontSize=11;spacingLeft=14;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="100" y="660" width="440" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n8" value="&lt;b&gt;ANSWERABLE&lt;/b&gt;&lt;br&gt;range resolved and clipped to coverage" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="980" y="370" width="440" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n9" value="compile → execute → validate result" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="980" y="465" width="440" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n10" value="&lt;b&gt;CLEAN&lt;/b&gt;&lt;br&gt;rows, no flags" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="620" y="600" width="260" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="n11" value="&lt;b&gt;DEGRADED&lt;/b&gt;&lt;br&gt;rows + data-quality flags" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FEF6E7;strokeColor=#B45309;fontColor=#4A2C05;" parent="1" vertex="1">
                    <mxGeometry x="910" y="600" width="260" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="n12" value="&lt;b&gt;EMPTY&lt;/b&gt;&lt;br&gt;no rows matched" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="600" width="260" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="n13" value="finding + chart" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="620" y="710" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n14" value="finding + chart + caveats&lt;br&gt;the caveat travels with the number" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="910" y="710" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n15" value="“Nothing matches that.”&lt;br&gt;The window resolved and was queried:&lt;br&gt;an empty result, not a missing one." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontColor=#1A202C;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="710" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="n3" target="n4" edge="1">
