                <mxCell id="n4" value="&lt;b&gt;Plan validator&lt;/b&gt;&lt;br&gt;the plan is a proposal; this is the verdict" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#E4F2F0;strokeColor=#0E6E63;fontColor=#08302C;" parent="1" vertex="1">
                    <mxGeometry x="600" y="220" width="320" height="80" as="geometry"/>
