                <mxCell id="n9" value="&lt;b&gt;What A hands the model&lt;/b&gt;&lt;br&gt;table selection · joins&lt;br&gt;metric definition · aggregation&lt;br&gt;row limits · the tenant predicate" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;align=center;fillColor=#FDE8E0;strokeColor=#C2410C;fontColor=#4A1A05;align=left;verticalAlign=top;fontSize=11;spacingLeft=14;spacingTop=10;" parent="1" vertex="1">
