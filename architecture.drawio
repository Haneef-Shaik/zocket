                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e28" value="LEFT JOIN — orphans survive as &#39;unmapped&#39;:&lt;br&gt;dropping them loses spend, folding them into a&lt;br&gt;real campaign misattributes it" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="n11" target="n16" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e29" value="JOIN on date + campaign currency&lt;br&gt;(the campaign owns the currency;&lt;br&gt;the row&#39;s own column is advisory)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0E6E63;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" parent="1" source="n15" target="n16" edge="1">
